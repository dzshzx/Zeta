      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, such as github"
          }
        }
      }
    },
    "命令，例如 npx": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, such as npx"
          }
        }
