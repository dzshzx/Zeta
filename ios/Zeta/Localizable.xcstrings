    "添加设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Device"
          }
        }
      }
    },
    "添加一台装了 Claude Code 的 Linux 设备，经 SSH 在上面开对话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a Linux device with Claude Code installed and chat with it over SSH."
          }
        }
      }
    },
    "添加这台设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add This Device"
          }
        }
      }
    },
    "停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "未知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "先把设置里 Zeta 的公钥加进那台设备的 ~/.ssh/authorized_keys。设备要是 arm64 或 x86-64 的 Linux，装着 bash 和 Claude Code。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First add Zeta’s public key from Settings to ~/.ssh/authorized_keys on the device. The device must be arm64 or x86-64 Linux with bash and Claude Code installed."
          }
        }
      }
    },
    "先讨论": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat First"
          }
        }
      }
    },
    "新对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Conversation"
          }
        }
      }
    },
    "选择一个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a Conversation"
          }
        }
      }
    },
    "用户@主机[:端口]": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "user@host[:port]"
