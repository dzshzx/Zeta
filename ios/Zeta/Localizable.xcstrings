    },
    "提交": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit"
          }
        }
      }
    },
    "添加设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Device"
          }
        }
      }
    },
    "添加一台装了 Claude Code 的 Linux 设备，经 SSH 在上面开对话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a Linux device with Claude Code installed and chat with it over SSH."
          }
        }
      }
    },
    "添加这台设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add This Device"
          }
        }
      }
    },
    "停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "未知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "先把设置里 Zeta 的公钥加进那台设备的 ~/.ssh/authorized_keys。设备要是 arm64 或 x86-64 的 Linux，装着 bash 和 Claude Code。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First add Zeta’s public key from Settings to ~/.ssh/authorized_keys on the device. The device must be arm64 or x86-64 Linux with bash and Claude Code installed."
          }
        }
      }
    },
    "先聊聊": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat First"
          }
        }
      }
    },
    "新对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Conversation"
          }
        }
      }
    },
    "选一个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a Conversation"
          }
        }
      }
    },
    "用户@主机[:端口]": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "user@host[:port]"
          }
        }
      }
    },
    "允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        }
      }
    },
    "允许 %@？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@?"
          }
        }
      }
    },
    "载入更早的消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load Earlier Messages"
          }
        }
      }
    },
    "找到了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        }
      }
    },
    "这一种请在桌面版或手机版上处理。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle this one in the desktop or Android app."
          }
        }
      }
    },
    "正在打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening"
          }
        }
      }
    },
    "正在回答": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering"
          }
        }
      }
    },
    "正在思考": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        }
      }
    },
    "只是 Zeta 不再连它，那边的会话记录不动。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta just stops connecting to it. Session history there stays untouched."
          }
        }
      }
    },
    "置顶": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned"
          }
        }
      }
    },
    "主机名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostname"
          }
        }
      }
    },
    "主机指纹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host Fingerprint"
          }
        }
      }
    },
    "总是允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow"
          }
        }
      }
    },
    "MCP 服务器在等你填写或打开网页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An MCP server is waiting for a form or a web page"
          }
        }
      }
    },
    "%lld 步": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld step"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld steps"
                }
              }
            }
          }
        }
      }
    },
    "Zeta 的公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta’s Public Key"
          }
        }
      }
    },
    "Zeta 起不来": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta Couldn’t Start"
          }
        }
      }
    },
    "导入私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Private Key"
          }
        }
      }
    },
    "换回 Zeta 的密钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Zeta’s Own Key"
          }
        }
      }
    },
    "导入的私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported Private Key"
          }
        }
      }
    },
    "Zeta 用导入的私钥登录，上面是它的公钥。私钥只在这台设备的钥匙串里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta signs in with the imported private key; its public key is shown above. The private key stays in this device’s keychain."
          }
        }
      }
    },
    "换回 Zeta 的密钥？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch back to Zeta’s own key?"
          }
        }
      }
    },
    "换回": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Back"
          }
        }
      }
    },
    "导入的私钥从这台设备上删掉，之后用 Zeta 自己的密钥登录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The imported private key is deleted from this device, and Zeta signs in with its own key again."
          }
        }
      }
    },
    "从文件选取": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose File"
          }
        }
      }
    },
    "私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Key"
          }
        }
      }
    },
    "粘贴或选取 OpenSSH、PEM 格式的私钥文件（如 ~/.ssh/id_ed25519），不是 .pub 公钥。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste or choose an OpenSSH or PEM private key file (such as ~/.ssh/id_ed25519), not a .pub public key."
          }
        }
      }
    },
    "没有密码就留空": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty if none"
          }
        }
      }
    },
    "密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase"
          }
        }
      }
    },
    "导入后私钥去掉密码存进这台设备的钥匙串，以后不再问。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After import, the key is stored in this device’s keychain without the passphrase, so you won’t be asked again."
          }
        }
      }
    },
    "导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
          }
        }
      }
    },
    "这个文件不是文本，不像私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file isn’t text, so it can’t be a private key"
          }
        }
      }
    },
    "类型": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        }
      }
    },
    "命令": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command"
          }
        }
      }
    },
    "名称，比如 github": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, such as github"
          }
        }
      }
    },
    "命令，比如 npx": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, such as npx"
          }
        }
      }
    },
    "参数（可选，空格分开）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments (optional, separated by spaces)"
          }
        }
      }
    },
    "环境变量（可选，每行一个 KEY=VALUE）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment variables (optional, one KEY=VALUE per line)"
          }
        }
      }
    },
    "服务器地址 https://": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server URL https://"
          }
        }
      }
    },
    "Bearer Token（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearer token (optional)"
          }
        }
      }
    },
    "添加服务器": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add server"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "添加": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "名称只能用字母、数字、下划线和连字符": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only letters, digits, underscores and hyphens in the name"
          }
        }
      }
    },
    "地址要以 http:// 或 https:// 开头": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL must start with http:// or https://"
          }
        }
      }
    },
    "请输入要运行的命令": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the command to run"
          }
        }
      }
    },
    "环境变量每行一个，写成 KEY=VALUE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put one environment variable per line, as KEY=VALUE"
          }
        }
      }
    },
    "还没有自定义 Subagent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No custom subagents yet"
          }
        }
      }
    },
    "让 Claude 写一个，或点右上角的“新建”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Claude to write one, or click “New” at the top right"
          }
        }
      }
    },
    "自定义 Subagent · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom subagents · %@"
          }
        }
      }
    },
    "存在 ~/.claude/agents，所有项目都能用。Claude 按“什么时候用”自己决定交给哪个，你也可以在对话里点名。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in ~/.claude/agents and available in every project. Claude picks one by its “When to use”, or you can name one in a conversation."
          }
        }
      }
    },
    "新建 Subagent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New subagent"
          }
        }
      }
    },
    "读取 Subagent 失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load subagents"
          }
        }
      }
    },
    "名称只能用小写字母、数字和连字符，并以字母或数字开头": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only lowercase letters, digits and hyphens, starting with a letter or digit"
          }
        }
      }
    },
    "写上什么时候用它才能保存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe when to use it before saving"
          }
        }
      }
    },
    "默认": {
      "localizations": {
