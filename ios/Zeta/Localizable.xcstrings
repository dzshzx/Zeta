        }
      }
    },
    "发消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        }
      }
    },
    "分享公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share Public Key"
          }
        }
      }
    },
    "复制公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Public Key"
          }
        }
      }
    },
    "关掉后 Zeta 不连这台设备，它上面的对话在那边照样跑。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, Zeta doesn’t connect to this device. Conversations on it keep running there."
          }
        }
      }
    },
    "还没有设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Devices Yet"
          }
        }
      }
    },
    "好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "环境": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment"
          }
        }
      }
    },
    "会话正在别处运行，在那边退出后才能在这里接着": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is running elsewhere. Exit it there to continue here."
          }
        }
      }
    },
    "或者开一个新对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or start a new conversation"
          }
        }
      }
    },
    "家目录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "检查连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Connection"
          }
        }
      }
    },
    "拒绝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deny"
          }
        }
