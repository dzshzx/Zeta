{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "把这一行加进设备上的 ~/.ssh/authorized_keys，Zeta 才能登录。私钥只在这台设备的钥匙串里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this line to ~/.ssh/authorized_keys on your device so Zeta can sign in. The private key stays in this device’s keychain."
          }
        }
      }
    },
    "版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "别处运行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running elsewhere"
          }
        }
      }
    },
    "不批准": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject"
          }
        }
      }
    },
    "不批准时，告诉 Claude 要怎么改": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reject, tell Claude what to change"
          }
        }
      }
    },
    "打不开这个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t open this conversation"
          }
        }
      }
    },
    "地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        }
      }
    },
    "对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations"
          }
        }
      }
    },
    "发送": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        }
      }
    },
    "发消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        }
      }
    },
    "分享公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share Public Key"
          }
        }
      }
    },
    "复制公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Public Key"
          }
        }
      }
    },
    "关掉后 Zeta 不连这台设备，它上面的对话在那边照样跑。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, Zeta doesn’t connect to this device. Conversations on it keep running there."
          }
        }
      }
    },
    "还没有设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Devices Yet"
          }
        }
      }
    },
    "好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "环境": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment"
          }
        }
      }
    },
    "会话正在别处运行，在那边退出后才能在这里接着": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is running elsewhere. Exit it there to continue here."
          }
        }
      }
    },
    "或者开一个新对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or start a new conversation"
          }
        }
      }
    },
    "家目录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "检查连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Connection"
          }
        }
      }
    },
    "拒绝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deny"
          }
        }
      }
    },
