      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage limit reached"
          }
        }
      }
    },
    "额度用完了，%@恢复": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage limit reached; resets %@"
