    },
    "批准": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        }
      }
    },
    "批准并自动接受改动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve and Auto-Accept Edits"
          }
        }
      }
    },
    "批准这个计划？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this plan?"
          }
        }
      }
    },
    "全部设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Devices"
          }
        }
      }
    },
    "删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "删除设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Device"
          }
