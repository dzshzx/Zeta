      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More Models"
          }
        }
      }
    },
    "更早的记录还没载入，没算进去。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier history isn’t loaded and isn’t counted."
          }
        }
      }
    },
    "管理常用指令": {
