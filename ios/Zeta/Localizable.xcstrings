{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "把这一行加进设备上的 ~/.ssh/authorized_keys，Zeta 才能登录。私钥只在这台设备的钥匙串里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this line to ~/.ssh/authorized_keys on your device so Zeta can sign in. The private key stays in this device’s keychain."
          }
        }
      }
    },
    "版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "别处运行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running elsewhere"
          }
        }
      }
    },
    "不批准": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject"
          }
        }
      }
    },
    "不批准时，告诉 Claude 要怎么改": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reject, tell Claude what to change"
          }
        }
      }
    },
    "打不开这个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t open this conversation"
