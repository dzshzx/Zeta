      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        }
      }
    },
    "批准并自动接受改动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve and Auto-Accept Edits"
          }
