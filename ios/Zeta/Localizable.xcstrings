            "value": "Allow %@?"
          }
        }
      }
    },
    "加载更早的消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load Earlier Messages"
          }
        }
      }
    },
    "已找到设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        }
      }
    },
    "这一种请在桌面版或手机版上处理。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle this one in the desktop or Android app."
          }
        }
      }
    },
    "正在打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening"
          }
        }
      }
    },
    "正在回答": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering"
          }
        }
      }
    },
    "正在思考": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        }
      }
    },
    "仅停止 Zeta 与此设备的连接，不会删除设备上的会话记录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta just stops connecting to it. Session history there stays untouched."
          }
        }
      }
    },
    "置顶": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned"
          }
        }
      }
    },
    "主机名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostname"
          }
        }
      }
    },
    "主机指纹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host Fingerprint"
          }
        }
      }
    },
    "总是允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow"
          }
        }
      }
    },
    "MCP 服务器在等你填写或打开网页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An MCP server is waiting for a form or a web page"
          }
        }
      }
