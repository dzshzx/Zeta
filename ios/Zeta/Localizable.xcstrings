{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "版本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "别处运行": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running elsewhere"
          }
        }
      }
    },
    "不批准": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject"
          }
        }
      }
    },
    "不批准时，告诉 Claude 要怎么改": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reject, tell Claude what to change"
          }
        }
      }
    },
    "打不开这个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t open this conversation"
          }
        }
      }
    },
    "地址": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        }
      }
    },
    "对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations"
          }
        }
      }
    },
    "发送": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        }
      }
    },
    "发消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        }
      }
    },
    "分享公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share Public Key"
          }
        }
      }
    },
    "复制公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Public Key"
          }
        }
      }
    },
    "关掉后 Zeta 不连这台设备，它上面的对话在那边照样跑。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, Zeta doesn’t connect to this device. Conversations on it keep running there."
          }
        }
      }
    },
    "还没有设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Devices Yet"
          }
        }
      }
    },
    "好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "环境": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment"
          }
        }
      }
    },
    "会话正在别处运行，在那边退出后才能在这里接着": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is running elsewhere. Exit it there to continue here."
          }
        }
      }
    },
    "或者开一个新对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or start a new conversation"
          }
        }
      }
    },
    "家目录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "检查连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Connection"
          }
        }
      }
    },
    "拒绝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deny"
          }
        }
      }
    },
    "来自 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %@"
          }
        }
      }
    },
    "连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        }
      }
    },
    "没有成功": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something Went Wrong"
          }
        }
      }
    },
    "（没有输出）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no output)"
          }
        }
      }
    },
    "批准": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        }
      }
    },
    "批准并自动接受改动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve and Auto-Accept Edits"
          }
        }
      }
    },
    "批准这个计划？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this plan?"
          }
        }
      }
    },
    "全部设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Devices"
          }
        }
      }
    },
    "删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "删除设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Device"
          }
        }
      }
    },
    "删除「%@」？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        }
      }
    },
    "设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices"
          }
        }
      }
    },
    "设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "思考": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        }
      }
    },
    "提交": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit"
          }
        }
      }
    },
    "添加设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Device"
          }
        }
      }
    },
    "添加一台装了 Claude Code 的 Linux 设备，经 SSH 在上面开对话。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a Linux device with Claude Code installed and chat with it over SSH."
          }
        }
      }
    },
    "添加这台设备": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add This Device"
          }
        }
      }
    },
    "停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        }
      }
    },
    "未知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "先把设置里 Zeta 的公钥加进那台设备的 ~/.ssh/authorized_keys。设备要是 arm64 或 x86-64 的 Linux，装着 bash 和 Claude Code。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First add Zeta’s public key from Settings to ~/.ssh/authorized_keys on the device. The device must be arm64 or x86-64 Linux with bash and Claude Code installed."
          }
        }
      }
    },
    "先聊聊": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat First"
          }
        }
      }
    },
    "新对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Conversation"
          }
        }
      }
    },
    "选一个对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a Conversation"
          }
        }
      }
    },
    "用户@主机[:端口]": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "user@host[:port]"
          }
        }
      }
    },
    "允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        }
      }
    },
    "允许 %@？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@?"
          }
        }
      }
    },
    "载入更早的消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load Earlier Messages"
          }
        }
      }
    },
    "找到了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        }
      }
    },
    "这一种请在桌面版或手机版上处理。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle this one in the desktop or Android app."
          }
        }
      }
    },
    "正在打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening"
          }
        }
      }
    },
    "正在回答": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering"
          }
        }
      }
    },
    "正在思考": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        }
      }
    },
    "只是 Zeta 不再连它，那边的会话记录不动。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta just stops connecting to it. Session history there stays untouched."
          }
        }
      }
    },
    "置顶": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned"
          }
        }
      }
    },
    "主机名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostname"
          }
        }
      }
    },
    "主机指纹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host Fingerprint"
          }
        }
      }
    },
    "总是允许": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow"
          }
        }
      }
    },
    "MCP 服务器在等你填写或打开网页": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An MCP server is waiting for a form or a web page"
          }
        }
      }
    },
    "%lld 步": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld step"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld steps"
                }
              }
            }
          }
        }
      }
    },
    "Zeta 的公钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta’s Public Key"
          }
        }
      }
    },
    "Zeta 起不来": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta Couldn’t Start"
          }
        }
      }
    },
    "导入私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Private Key"
          }
        }
      }
    },
    "换回 Zeta 的密钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Zeta’s Own Key"
          }
        }
      }
    },
    "导入的私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported Private Key"
          }
        }
      }
    },
    "换回 Zeta 的密钥？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch back to Zeta’s own key?"
          }
        }
      }
    },
    "换回": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Back"
          }
        }
      }
    },
    "导入的私钥从这台设备上删掉，之后用 Zeta 自己的密钥登录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The imported private key is deleted from this device, and Zeta signs in with its own key again."
          }
        }
      }
    },
    "从文件选取": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose File"
          }
        }
      }
    },
    "私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Key"
          }
        }
      }
    },
    "粘贴或选取 OpenSSH、PEM 格式的私钥文件（如 ~/.ssh/id_ed25519），不是 .pub 公钥。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste or choose an OpenSSH or PEM private key file (such as ~/.ssh/id_ed25519), not a .pub public key."
          }
        }
      }
    },
    "没有密码就留空": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty if none"
          }
        }
      }
    },
    "密码": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase"
          }
        }
      }
    },
    "导入后私钥去掉密码存进这台设备的钥匙串，以后不再问。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After import, the key is stored in this device’s keychain without the passphrase, so you won’t be asked again."
          }
        }
      }
    },
    "导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
          }
        }
      }
    },
    "Zeta 用导入的私钥登录，上面是它的公钥。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeta signs in with the imported private key; its public key is shown above."
          }
        }
      }
    },
    "把这一行加进设备上的 ~/.ssh/authorized_keys，Zeta 才能登录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this line to ~/.ssh/authorized_keys on your device so Zeta can sign in."
          }
        }
      }
    },
    "私钥只在这台设备的钥匙串里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key stays in this device’s keychain."
          }
        }
      }
    },
    "这个文件不像私钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file doesn’t look like a private key"
          }
        }
      }
    }
  }
}
