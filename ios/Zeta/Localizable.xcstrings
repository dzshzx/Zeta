      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something Went Wrong"
          }
        }
      }
    },
    "（没有输出）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no output)"
          }
        }
