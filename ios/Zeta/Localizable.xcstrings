      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments (optional, separated by spaces)"
          }
        }
      }
    },
    "环境变量（可选，每行一个 KEY=VALUE）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment variables (optional, one KEY=VALUE per line)"
          }
        }
      }
    },
    "服务器地址 https://": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server URL https://"
          }
        }
      }
    },
    "Bearer Token（可选）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearer token (optional)"
          }
        }
      }
    },
    "添加服务器": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add server"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "添加": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "名称仅支持字母、数字、下划线和连字符": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only letters, digits, underscores and hyphens in the name"
          }
        }
      }
    },
    "地址须以 http:// 或 https:// 开头": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL must start with http:// or https://"
          }
        }
      }
    },
    "请输入要运行的命令": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the command to run"
          }
        }
      }
    },
    "环境变量每行一条，格式为 KEY=VALUE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put one environment variable per line, as KEY=VALUE"
          }
        }
      }
    },
    "暂无自定义 Subagent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No custom subagents yet"
          }
        }
      }
    },
    "可让 Claude 生成，或点击右上角“新建”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Claude to write one, or click “New” at the top right"
          }
        }
      }
    },
    "自定义 Subagent · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom subagents · %@"
          }
        }
      }
    },
    "保存在 ~/.claude/agents，所有项目通用。Claude 会根据“适用场景”自动委派，你也可以在对话中直接指定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in ~/.claude/agents and available in every project. Claude picks one by its “When to use”, or you can name one in a conversation."
          }
        }
      }
    },
    "新建 Subagent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New subagent"
          }
        }
      }
    },
    "读取 Subagent 失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load subagents"
          }
        }
      }
    },
    "名称仅支持小写字母、数字和连字符，且须以字母或数字开头": {
      "localizations": {
        "en": {
          "stringUnit": {
