<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 直连远程主机：手机换网络时马上断开旧的 SSH 连接、重连 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 对话在回答时常驻通知提升为实时通知（Android 16 起的 Live Updates，状态栏和锁屏上显示） -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 定时任务：到点准时（setAlarmClock 要它），开机后重排闹钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 按住说话、数字助理的识别服务转给手机原有的识别服务：系统的识别服务替 Zeta 录音，按调用方核对麦克风权限；朗读回答时退到后台继续读 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 健康连接（search_personal 的 health，只读）：由权限健康页经 root 授予，和 HealthSummary.PERMISSIONS 一致 -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- 应用内更新没有 root 时交给系统安装（PackageInstaller 会话，用户确认）；有 root 时经 pm install，用不到它 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 按名字找应用、打开应用：只需要能看到有桌面图标的那些 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 系统默认的桌面：手机工具只在主屏上打开它（PhoneTools.homePackage） -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- 系统自带的语音识别和朗读引擎（小米的在 com.xiaomi.mibrain.speech）；数字助理的识别服务也靠它找到小米的转过去 -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 系统应用开给系统智能体的工具服务（phone/tools/AppTools.kt） -->
        <intent>
            <action android:name="com.aios.osbot.action.APP_TOOL_PROVIDER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:description="@string/xposed_description"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Zeta">
        <!-- 旋转屏幕、切深浅色时不重建：界面由 Compose 跟着配置重画，开着的对话框、输入框和滚动位置都留着 -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- “用其他应用打开”里能选 Zeta：文本、代码、Markdown、PDF、图片，放进对话当附件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-javascript" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/x-python" />
                <data android:mimeType="application/x-python-code" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/x-subrip" />
            </intent-filter>
        </activity>

        <!-- 健康连接要求要健康权限的应用声明“权限用途”入口（系统健康连接设置里的隐私说明），点了打开 Zeta -->
        <activity-alias
            android:name=".HealthPermissionUsage"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- 内置浏览器页：看 Claude 在用的网页、接管、清除数据 -->
        <activity
            android:name=".ui.browser.BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".phone.ZetaAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/zeta_accessibility" />
        </service>
        <!-- 把后台屏幕的画面缓冲交给 root 辅助进程；只认 root 和 system 身份的调用 -->
        <provider
            android:name=".phone.VdSurfaceProvider"
            android:authorities="${applicationId}.background"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.MANAGE_ACCESSIBILITY" />
        <!-- 定时任务的闹钟，以及要重排闹钟的系统广播（都由系统发，不必导出） -->
        <receiver
            android:name=".core.schedule.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- 应用内更新交给系统安装（PackageInstaller 会话）后的结果：要用户确认、取消了、装不上 -->
        <receiver
            android:name=".core.update.UpdateInstallReceiver"
            android:exported="false" />
        <!-- 通知触发的任务：别的应用发通知时实时收到（系统设置里的“通知使用权”） -->
        <service
            android:name=".core.notify.ZetaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- 快速设置里的「截屏给 Claude」磁贴 -->
        <service
            android:name=".phone.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_capture"
            android:label="@string/capture_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- 朗读回答时的前台服务：退到后台、锁屏后接着读 -->
        <service
            android:name=".core.voice.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- 数字助理：系统助理会话和 ASSIST 打开的浮窗（盖在当前应用上，不进最近任务） -->
        <activity
            android:name=".assistant.AssistantActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.assistant"
            android:theme="@style/Theme.Zeta.Assistant"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <service
            android:name=".assistant.ZetaVoiceInteractionService"
            android:exported="true"
            android:label="@string/assistant_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/zeta_voice_interaction" />
        </service>
        <service
            android:name=".assistant.ZetaVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".assistant.ZetaRecognitionService"
            android:exported="true"
            android:label="@string/recognition_label">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/zeta_recognition_service" />
        </service>
        <service
            android:name=".core.AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the local Claude Code process alive while a conversation is open" />
        </service>
    </application>
</manifest>
