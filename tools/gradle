#!/bin/bash
# 用本项目的 JDK（见 tools/java-home）和 Android SDK 启动 Gradle wrapper，参数原样传给 gradlew。
# 工作站和手机 Debian 的 SDK 都在 ~/Android/Sdk；这样任务树里不用放 local.properties。
set -euo pipefail
cd "$(dirname "$0")/.."
JAVA_HOME=$(tools/java-home)
export JAVA_HOME
export ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk}
# 并行开发时几棵任务树会同时构建：最多同时跑 ZETA_GRADLE_SLOTS 个（默认 2），其余排队，免得内存撑爆。
# 一次门禁构建（assembleDebug 加 testDebugUnitTest）内存峰值约 7G；两个构建加上共用的模拟器（约 6G）和各会话自身，
# 刚好放进 agent 会话合计的内存上限，三个就放不下。
# 锁挂在 gradlew 进程上，它结束就释放；Gradle 守护进程不继承这个文件描述符。
slots=${ZETA_GRADLE_SLOTS:-2}
lockdir=${XDG_RUNTIME_DIR:-/tmp}/zeta-gradle
mkdir -p "$lockdir"
got=
for ((i = 1; i <= slots; i++)); do
  exec 9>"$lockdir/slot$i"
  if flock -n 9; then got=1; break; fi
done
if [[ -z $got ]]; then
  echo "tools/gradle: 已有 $slots 个构建在跑，排队等待" >&2
  exec 9>"$lockdir/slot$(($$ % slots + 1))"
  flock 9
fi
# 这次要起的守护进程和它派生的测试进程单独一个分组（见 tools/own-scope.sh）。已有空闲守护进程时构建在它那里跑，
# 用量记在它的分组上；一个守护进程同时只跑一个构建，上限按单个构建的峰值定。
source tools/own-scope.sh
own_scope zeta-gradle 10G
exec "${OWN_SCOPE[@]}" ./gradlew "$@"
