#!/bin/bash
# 手机测试的租约，按包发：
#   dev   测试版 com.dzshzx.zeta.dev，同时只给一个人（真机测试走 tools/phone-run 排队，一般不用直接调）
#   main  正式版 com.dzshzx.zeta，只有负责合入的会话用（tools/install.sh、vd.py 不带 --dev 时）
# 已经占着的再要就续租。tools/install.sh 和 tools/vd.py 在工作站上每次碰手机前都调它，拿不到就以退出码 75 失败。
# 占用者名字取 ZETA_PHONE_OWNER（默认 main）；15 分钟没动静的租约自动作废。
# 用完释放手上的全部租约：ZETA_PHONE_OWNER=<名字> tools/phone-lock --release。只协调工作站上的会话。
set -euo pipefail
owner=${ZETA_PHONE_OWNER:-main}
dir=${XDG_RUNTIME_DIR:-/tmp}
ttl=900
file() { case $1 in main) echo "$dir/zeta-phone-main.lease" ;; *) echo "$dir/zeta-phone.lease" ;; esac; }
exec 9>"$dir/zeta-phone.lease.lock"
flock 9
now=$(date +%s)
holder() { # 打印租约 $1 的有效占用者，没有或过期就空
  local h= s=0
  [[ -f $(file "$1") ]] && read -r h s <"$(file "$1")"
  if [[ -n $h ]] && ((now - s < ttl)); then echo "$h"; fi
}

case ${1:-dev} in
  --release)
    for k in main dev; do [[ $(holder "$k") == "$owner" ]] && rm -f "$(file "$k")"; done
    exit 0 ;;
  main | dev)
    h=$(holder "$1")
    if [[ -n $h && $h != "$owner" ]]; then
      echo "$([[ $1 == main ]] && echo 正式版 || echo 测试版)正被 $h 占用；先做别的，稍后再试" >&2
      exit 75
    fi
    echo "$owner $now" >"$(file "$1")" ;;
  *) echo "用法：tools/phone-lock [dev|main|--release]" >&2; exit 2 ;;
esac
