#!/bin/bash
# 测试设备的租约，按设备和包发：
#   emu   模拟器上的测试版 com.dzshzx.zeta.dev（测试版默认装在这里），同时只给一个 phone-run
#   dev   手机上的测试版（ZETA_DEVICE=phone），同时只给一个 phone-run
#         测试版都走 tools/phone-run 排队，一般不用直接调
#   main  手机上的正式版 com.dzshzx.zeta，只有主会话在上线时用（tools/install.sh、vd 带 --release 时）
# 已经占着的再要就续租。tools/install.sh 和 tools/vd 在工作站上每次碰设备前都调它，拿不到就以退出码 75 失败；
# 在 phone-run 里（有 ZETA_PHONE_TICKET）vd 不调，用 phone-run 拿到的这一份，装包时 install.sh 续一次。
# 占用者名字取 ZETA_PHONE_OWNER，没设时对测试版算主会话（main），正式版例外，见下面「谁能拿」那一段；15 分钟没动静的租约自动作废，
# 有 phone-run 在排队时，直接用（install.sh、vd，不在 phone-run 里）拿的租约 3 分钟没动静就作废（见 ttl_waited）。
# 测试版先来先到：phone-run 把自己的进程号放进 ZETA_PHONE_TICKET 排队，排在最前面的才拿得到，进程没了号就作废。
# 租约记着拿到它的 phone-run，同一个占用者的另一个 phone-run 也得等它跑完。
# 用完释放手上的全部租约：ZETA_PHONE_OWNER=<名字> tools/phone-lock --release（顺带撤掉同名的模拟器登记）。只协调工作站上的会话。
# 谁能拿也在这里定（vd、install.sh 不另写）：正式版只给写明了 ZETA_PHONE_OWNER=main 的主会话，没设不给，phone-run 里
# 也不给；占用者不是 main（子代理）时只给 phone-run 里的调用（带 ZETA_PHONE_TICKET）。拿不到时退出码 2，不是 75：
# 这不是等一会儿就能好的。
# --check <种类> 只核对这条、不拿租约：install.sh 在构建前先问一次，免得构建完才被拒绝；不拿租约的地方（手机 Debian 里、
# phone-run 里）碰正式版前，install.sh 和 vd 也先问它。
set -euo pipefail
owner=${ZETA_PHONE_OWNER:-main}
ticket=${ZETA_PHONE_TICKET:-}
dir=${XDG_RUNTIME_DIR:-/tmp}
allowed() { # 占用者能不能拿种类 $1 的租约，不能就说明原因
  if [[ $1 == main ]]; then
    # 正式版是用户日常在用的：没写明自己是主会话的不给，忘了设 ZETA_PHONE_OWNER 的调用不会被当成主会话
    if [[ ${ZETA_PHONE_OWNER:-} != main ]]; then
      echo "正式版只由主会话在上线时碰，命令前要写明 ZETA_PHONE_OWNER=main（现在${ZETA_PHONE_OWNER:+是 }${ZETA_PHONE_OWNER:-没设}）；开发测试用测试版：去掉 --release" >&2
      return 1
    fi
    if [[ -n $ticket ]]; then
      echo "tools/phone-run 里不碰正式版：它排的是测试版的队，上线和上线后的验证由主会话直接跑" >&2
      return 1
    fi
  fi
  if [[ $owner != main && -z $ticket ]]; then
    echo "子代理（ZETA_PHONE_OWNER=$owner）碰设备只经 tools/phone-run：把要做的写成脚本交给它排队跑" >&2
    return 1
  fi
}
if [[ ${1-} == --check ]]; then allowed "${2-}" || exit 2; exit 0; fi
ttl=900
# 有 phone-run 在等时，直接用拿的租约没动静多久就让出来。phone-run 拿的跟着它的进程走，跑完就放；直接用的没有进程可跟，
# 只能按时间算，等的一方不该白等 15 分钟。没人排队时照 ttl，一个人连着手动调试不受影响（直接调用的相邻间隔一半在 1 分钟内）。
ttl_waited=180
file() { case $1 in main) echo "$dir/zeta-phone-main.lease" ;; emu) echo "$dir/zeta-emu.lease" ;; *) echo "$dir/zeta-phone.lease" ;; esac; }
exec 9>"$dir/zeta-phone.lease.lock"
flock 9
now=$(date +%s)
h='' hpid=''
read_holder() { # 租约 $1 的有效占用者 h、拿到它的 phone-run 进程号 hpid，没有或过期就空；last 是最后一次续租的时刻，
  # expires 是没动静的话什么时候作废。$2 非空：有 phone-run 在等这份租约（见 ttl_waited）
  local limit=$ttl
  h='' hpid='' last=0
  [[ -f $(file "$1") ]] && read -r h last hpid <"$(file "$1")"
  [[ -z $hpid && -n ${2-} && $1 != main ]] && limit=$ttl_waited
  expires=$((last + limit))
  ((now < expires)) || h='' hpid=''
  # 拿着它的 phone-run 已经不在了（被强行结束、没来得及释放）：马上作废，不等 15 分钟
  if [[ -n $hpid ]] && ! alive "$hpid"; then h='' hpid=''; fi
}
alive() { [[ -n $1 ]] && kill -0 "$1" 2>/dev/null; }
# 租约在同一个占用者的另一个还活着的 phone-run 手里
other_run() { [[ -n $hpid && $hpid != "$ticket" ]] && alive "$hpid"; }

case ${1-} in
  --release)
    for k in main dev emu; do
      read_holder "$k"
      if [[ $h == "$owner" ]] && ! other_run; then rm -f "$(file "$k")"; fi
    done
    # 直接用 install.sh、vd 时它们经 tools/emu start 登记了模拟器（phone-run 自己撤它的那份）
    [[ -n ${ZETA_PHONE_TICKET:-} ]] || "$(dirname "$0")/emu" release
    exit 0 ;;
  main | dev | emu)
    allowed "$1" || exit 2
    read_holder "$1" "${ticket:+waited}"
    case $1 in main) name=手机上的正式版 ;; dev) name=手机上的测试版 ;; *) name=模拟器上的测试版 ;; esac
    if [[ $h == "$owner" ]] && ! other_run; then # 自己占着：续租
      echo "$owner $now ${hpid:-$ticket}" >"$(file "$1")"
      exit 0
    fi
    first_pid='' first_owner='' ahead=0
    queue=$dir/zeta-$([[ $1 == emu ]] && echo emu || echo phone).queue
    if [[ $1 != main ]]; then
      # 先领号再看轮没轮到：设备被占着时来的也按到达顺序排
      touch "$queue"
      while read -r p o t; do if alive "$p"; then echo "$p $o $t"; fi; done <"$queue" >"$queue.tmp"
      mv "$queue.tmp" "$queue"
      if [[ -n $ticket ]] && ! grep -q "^$ticket " "$queue"; then echo "$ticket $owner $now" >>"$queue"; fi
      read -r first_pid first_owner _ <"$queue" || true
      ahead=$(awk -v t="$ticket" '$1 == t { print NR - 1; f = 1 } END { if (!f) print NR }' "$queue")
    fi
    if [[ -n $h ]]; then
      who=$([[ $h == "$owner" ]] && echo "你（$owner）的另一个 phone-run" || echo "$h")
      if [[ -n $hpid ]]; then
        when="它的 phone-run 跑完就放"
      else
        when="直接用的，最后一次动它在 $(date -d "@$last" +%H:%M:%S)，没动静的话 $(date -d "@$expires" +%H:%M:%S) 作废"
      fi
      echo "${name}正被${who}占用（${when}）$([[ $1 != main ]] && echo "，你前面还有 $ahead 个在排队")；先做别的，稍后再试" >&2
      exit 75
    fi
    if [[ -n $first_pid && $first_pid != "$ticket" ]]; then
      echo "${name}在排队：你前面还有 $ahead 个，最前面是 $first_owner" >&2
      exit 75
    fi
    if [[ -n $ticket && $1 != main ]]; then
      grep -v "^$ticket " "$queue" >"$queue.tmp" || true
      mv "$queue.tmp" "$queue"
    fi
    echo "$owner $now $ticket" >"$(file "$1")" ;;
  *) echo "用法：tools/phone-lock [emu|dev|main|--release|--check <种类>]" >&2; exit 2 ;;
esac
