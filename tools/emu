#!/bin/bash
# 测试版默认装在本机的 Android 模拟器上（见 CLAUDE.md「测试设备」）。用法：tools/emu [start|status|stop]
#   start   没开就开机：AVD 取 ZETA_AVD（或 git config zeta.avd），没配时用本机唯一的那个 AVD；
#           窗口开在 ZETA_EMU_DISPLAY（或 zeta.emuDisplay）这个 X 显示上，没配时不开窗口（-no-window）。
#           联网经宿主的代理（https_proxy，用 -http-proxy 交给模拟器：它不读代理环境变量）。
#           等开机完成，再把 adbd 切成 root。已经开着就只做后两步。install.sh、vd.py、phone-run 碰模拟器前自己调。
#   status  开着没有；开着时列出开机、root、代理和看守的状态
#   stop    关机（模拟器先存快照，下次开机从快照恢复）。模拟器可以和别的项目共用，测完不用关
#   watch   start 在后台自动起的看守：空闲满 ZETA_EMU_IDLE_MIN 分钟就关机，见 CLAUDE.md「测试设备」
set -euo pipefail
export ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk}
source "$(dirname "$0")/config.sh"
source "$(dirname "$0")/own-scope.sh"
PORT=5554 SERIAL=emulator-5554
WINDOW=$(zeta_config ZETA_EMU_DISPLAY emuDisplay)
# 不把 start 的锁（9 号描述符）带进 adb：第一次调用会拉起常驻的 adb 后台服务，它会一直攥着锁
adb() { "$ANDROID_HOME/platform-tools/adb" -s "$SERIAL" "$@" 9>&-; }
dir=${XDG_RUNTIME_DIR:-/tmp}
idle_min=${ZETA_EMU_IDLE_MIN:-30}
used_mark=$dir/zeta-emu.used        # 每次 start 都更新它的改动时间：「有人用」的记号
watch_lock=$dir/zeta-emu-watch.lock # 看守在时有人攥着它的锁

# 监听控制台端口的就是模拟器进程，按端口找，不靠 $!
emu_pid() { ss -Hltnp "sport = :$PORT" | grep -oE 'pid=[0-9]+' | head -n 1 | cut -d= -f2 || true; }
booted() { [[ $(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r') == 1 ]]; }
is_root() { [[ $(adb shell id -u 2>/dev/null | tr -d '\r') == 0 ]]; }

host_proxy=${https_proxy:-${http_proxy:-}}
# 开着的模拟器带的代理；别的项目（比如抓包）用别的 -http-proxy 开它时，Zeta 的联网都经那个代理
running_proxy() {
  local pid
  pid=$(emu_pid)
  [[ -n $pid ]] && tr '\0' '\n' <"/proc/$pid/cmdline" | grep -A1 -x -- -http-proxy | tail -n +2 || true
}

# 关机：模拟器自己先存快照，最多等 90 秒（存 4G 内存的快照约 20 秒）
stop_emu() {
  local pid=$1 i
  adb emu kill >/dev/null || true
  for ((i = 0; i < 90; i++)); do kill -0 "$pid" 2>/dev/null || return 0; sleep 1; done
  return 1
}

# xpra 在窗口所在显示上监听的 socket（抽象地址 @xpra/<号>、xpra/<号>/socket、~/.xpra/<主机>-<号>），写成 ss 的过滤条件
xpra_sockets() { echo "( src *xpra/${WINDOW#:} or src *xpra/${WINDOW#:}/socket or src */.xpra/*-${WINDOW#:} )"; }
# 有人在看：有 xpra 客户端连着这些 socket。配了窗口却找不到 xpra 在监听（布局变了、xpra 没起）时也算，宁可不关
xpra_watched() {
  [[ -n $WINDOW ]] || return 1
  [[ -z $(ss -Hxl "$(xpra_sockets)") || -n $(ss -Hx state established "$(xpra_sockets)") ]]
}

# 从 since（看守起来或最近一次有人用的时刻）算起空闲满 idle_min 分钟没有，顺带把 since 推到最近一次使用：
# 记号文件（start 每次更新）和设备租约（拿到、续租时写）取较晚的改动时间；正连着 adb 服务的进程、xpra_watched 算作此刻在用
idle() {
  local t
  if [[ -n $(ss -Htn state established "( dport = :5037 )") ]] || xpra_watched; then
    since=$EPOCHSECONDS
    return 1
  fi
  for t in $(stat -c %Y "$used_mark" "$dir/zeta-emu.lease" 2>/dev/null); do ((t <= since)) || since=$t; done
  ((EPOCHSECONDS - since >= idle_min * 60))
}

watching() { ! flock -n "$watch_lock" true; }

# 看守本身：由 ensure_watch 经 flock 起，锁攥在外面那个 flock 进程手里，这里起的子进程都不带它
watch() {
  local pid msg
  since=$EPOCHSECONDS
  pid=$(emu_pid)
  while kill -0 "$pid" 2>/dev/null; do
    sleep 60
    idle || continue
    # 拿 start 的锁再看一遍，不和正在开机或接上的 start 撞上
    exec 9>"$dir/zeta-emu.lock"
    if flock -n 9 && idle; then
      msg="已关模拟器（进程 $pid）"
      stop_emu "$pid" || msg="关模拟器（进程 $pid）90 秒没关掉"
      printf '%(%F %T)T 空闲满 %s 分钟，%s\n' -1 "$idle_min" "$msg" >>"$dir/zeta-emu-watch.log"
      break
    fi
    exec 9>&-
  done
}

# start 结束前确认看守在：只看按本机配置开的这台（$1 是它开机时带的代理，和宿主的一样）。看守单独一个小分组，在 / 下跑，
# 不攥 start 的锁和输出管道；看守锁由 flock -o 攥着，不传给看守和它的子进程。等 2 秒（status 探测时会短暂占着），
# 拿不到就是已有看守，静默退出
ensure_watch() {
  local self
  ((idle_min > 0)) && [[ $1 == "$host_proxy" ]] && ! watching || return 0
  self=$(realpath "$0")
  own_scope zeta-emu-watch 32M
  (cd / && exec "${OWN_SCOPE[@]}" setsid flock -o -w 2 -E 0 "$watch_lock" bash "$self" watch) >/dev/null 2>&1 </dev/null 9>&- &
}

# 要开的 AVD：配了就用配的，没配时本机只有一个 AVD 就用它
avd() {
  local name list
  name=$(zeta_config ZETA_AVD avd)
  if [[ -z $name ]]; then
    list=$("$ANDROID_HOME/emulator/emulator" -list-avds 2>/dev/null | grep -v '^INFO' || true)
    [[ -n $list && $(wc -l <<<"$list") == 1 ]] || {
      echo "不知道开哪个 AVD（本机有：${list//$'\n'/、}）：设 ZETA_AVD，或 git config zeta.avd <名字>" >&2
      exit 2
    }
    name=$list
  fi
  printf '%s' "$name"
}

start() {
  # adb 服务先在 / 下起好：由后面的调用顺带拉起的话，它的工作目录会留在调用方的任务树里，那棵树就回收不了
  (cd / && exec "$ANDROID_HOME/platform-tools/adb" start-server) >/dev/null 2>&1 </dev/null
  exec 9>"$dir/zeta-emu.lock"
  flock 9 # 几个 phone-run 同时来时只开一次
  touch "$used_mark"
  if [[ -z $(emu_pid) ]]; then
    local name window=(-no-window)
    name=$(avd)
    [[ -z $WINDOW ]] || window=()
    echo "开模拟器 $name（窗口${WINDOW:+在 $WINDOW}$([[ -n $WINDOW ]] || echo 不开)，代理 ${host_proxy:-无}，日志 $dir/zeta-emu.log）"
    # 模拟器常驻：在 / 下开（当前目录留在任务树里，那棵树回收不了）；重定向放在子 shell 上、子 shell 里 exec，
    # 不留中间进程（它会一直攥着锁和调用方的输出管道，后来的 start 和调用方都等着）。
    # 它各项目共用，单独一个分组（见 tools/own-scope.sh），不记在开它的会话头上；上限按 AVD 的 4G 内存加模拟器自身留够。
    own_scope zeta-emu 8G
    (cd / && DISPLAY=$WINDOW exec "${OWN_SCOPE[@]}" setsid "$ANDROID_HOME/emulator/emulator" -avd "$name" -port "$PORT" -no-audio -no-boot-anim \
      -gpu swiftshader_indirect "${window[@]}" ${host_proxy:+-http-proxy "$host_proxy"}) >"$dir/zeta-emu.log" 2>&1 </dev/null 9>&- &
  fi
  local i
  for ((i = 0; i < 180; i++)); do booted && break; sleep 1; done
  booted || { echo "模拟器 3 分钟没开机完成，看 $dir/zeta-emu.log" >&2; exit 1; }
  if ! is_root; then
    adb root >/dev/null
    for ((i = 0; i < 30; i++)); do is_root && break; sleep 1; done
    is_root || { echo "adbd 切不成 root" >&2; exit 1; }
  fi
  local proxy
  proxy=$(running_proxy)
  [[ $proxy == "$host_proxy" ]] ||
    echo "注意：模拟器开机时带的代理是「${proxy:-无}」，不是宿主的「${host_proxy:-无}」（多半是别的项目开的）；Zeta 要正常联网先 tools/emu stop 再开" >&2
  ensure_watch "$proxy"
}

case ${1:-start} in
  start) start ;;
  status)
    pid=$(emu_pid)
    [[ -n $pid ]] || { echo "模拟器没开"; exit 0; }
    s="模拟器开着（进程 $pid）"
    booted && s+="，已开机" || s+="，还在开机"
    is_root && s+="，adbd 是 root"
    s+="，代理：$(running_proxy)"
    watching && s+="，空闲满 $idle_min 分钟自动关机"
    echo "$s" ;;
  stop)
    pid=$(emu_pid)
    [[ -n $pid ]] || { echo "模拟器没开"; exit 0; }
    stop_emu "$pid" && { echo "关了"; exit 0; }
    echo "模拟器 90 秒没关掉（进程 $pid）" >&2
    exit 1 ;;
  watch) watch ;;
  *) echo "用法：tools/emu [start|status|stop]" >&2; exit 2 ;;
esac
